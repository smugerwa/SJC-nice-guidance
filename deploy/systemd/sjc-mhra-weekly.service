[Unit]
Description=MHRA alerts and updates weekly review
Documentation=https://github.com/smugerwa/sjc-nice-guidance
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sjcguidance
Group=sjcguidance
WorkingDirectory=/opt/sjc-guidance
EnvironmentFile=-/opt/sjc-guidance/.env
# Review the seven days ending yesterday, so the window is complete and
# consecutive runs leave no unreviewed hours.
ExecStart=/opt/sjc-guidance/deploy/run_mhra_weekly.sh --previous-week
TimeoutStartSec=2h
Nice=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sjc-guidance
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
