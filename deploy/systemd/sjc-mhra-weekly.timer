[Unit]
Description=Run the MHRA alerts review every Monday morning
Documentation=https://github.com/smugerwa/sjc-nice-guidance

[Timer]
# Monday 08:00 in the VPS system timezone, covering the previous seven days.
OnCalendar=Mon 08:00:00
Persistent=true
RandomizedDelaySec=10m
Unit=sjc-mhra-weekly.service

[Install]
WantedBy=timers.target
